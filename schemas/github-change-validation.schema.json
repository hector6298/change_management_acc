{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/change-assurance/github-change-validation.schema.json",
  "title": "GitHub Jira Change Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "observed_at", "result", "reason_codes", "change_id", "github", "policy_version", "validator_version"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_type": { "const": "github_change_validation" },
    "observed_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["PASS", "FAILURE", "ERROR", "SKIPPED"] },
    "change_id": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9]+-[1-9][0-9]*$" },
    "github": {
      "type": ["object", "null"],
      "properties": {
        "repository": { "type": "string" },
        "pull_request": { "type": "integer" },
        "pull_request_url": { "type": ["string", "null"], "format": "uri" },
        "title": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "base_branch": { "type": "string" },
        "head_sha": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "workflow_run_attempt": { "type": "integer", "minimum": 1 },
        "commit_shas": { "type": "array", "items": { "type": "string" } },
        "is_production_bound": { "type": "boolean" }
      },
      "required": ["repository", "pull_request", "pull_request_url", "title", "branch", "base_branch", "head_sha", "workflow_run_id", "workflow_run_attempt", "is_production_bound"],
      "additionalProperties": false
    },
    "jira": {
      "type": ["object", "null"],
      "properties": {
        "issue_url": { "type": "string", "format": "uri" },
        "issue_type": { "type": "string" },
        "status": { "type": "string" },
        "approval_state": { "type": ["string", "null"] },
        "approval_history_state": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "target_environment": { "type": ["string", "null"] },
        "risk": { "type": ["string", "null"] },
        "required_fields": { "type": "object", "additionalProperties": true }
      },
      "required": ["issue_url", "issue_type", "status", "approval_state", "approval_history_state", "approved_by", "approved_at", "target_environment", "risk", "required_fields"],
      "additionalProperties": false
    },
    "reason_codes": { "type": "array", "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } }, "additionalProperties": false } },
    "policy_version": { "type": "string" },
    "validator_version": { "type": "string" }
  }
}
